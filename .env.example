# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend administration and Airtable sync
API_PORT=4000
# Accounts use browser sessions. ADMIN_API_KEY is no longer used.
API_HOST=127.0.0.1
APP_ORIGIN="http://localhost:3000"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=marie_louise_school
MYSQL_USER=marie_app
MYSQL_PASSWORD="REPLACE_LOCALLY"
# On Vercel use a hosted address, never localhost or 127.0.0.1.
# Enable TLS in the hosting environment. Keep local MySQL settings as above.
MYSQL_SSL=false
# Optional: provider CA certificate PEM (literal \n escapes are supported).
# MYSQL_SSL_CA=""
AIRTABLE_API_TOKEN="YOUR_AIRTABLE_PERSONAL_ACCESS_TOKEN"
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
AIRTABLE_STUDENTS_TABLE="tblu1valgGsqlXkrX"
AIRTABLE_EXPORT_DIR=".local/airtable-exports"

# Parent sign-in codes (required before parents can sign in). Use a school-owned mailbox.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="portal@example.com"
SMTP_PASSWORD="REPLACE_LOCALLY"
MAIL_FROM="Marie Louise School <portal@example.com>"
# Local testing only: write sign-in emails to .local/outbox instead of sending (ignored in production).
# MAIL_TRANSPORT=dev-outbox

# Optional Google Identity Services Web Client ID for STAFF sign-in. No client secret is needed.
# Leave empty until Google Cloud has the website's authorized JavaScript origins.
GOOGLE_CLIENT_ID=""
